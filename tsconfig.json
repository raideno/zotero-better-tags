{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2018", "DOM"],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": ["zotero-types"],
    "allowJs": true,
    "noEmit": false
  },
  "include": ["src/**/*", "node_modules/zotero-types"],
  "exclude": ["dist", "node_modules"]
}
